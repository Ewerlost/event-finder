DATABASE_URL=postgresql+psycopg://event_finder_user:event_finder_password@localhost:5432/event_finder_db
JWT_KEY=change_me_to_a_long_random_secret
JWT_ISSUER=EventFinder.Api
JWT_AUDIENCE=EventFinder.Client
JWT_EXPIRES_MINUTES=5000
# HashRouter: ссылка должна вести на /event-finder/#/email-confirmation и /event-finder/#/reset-password
FRONTEND_URL=http://127.0.0.1:5173/event-finder/#
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://alexthunder2005.github.io
MAILERSEND_API_TOKEN=
MAILERSEND_FROM_EMAIL=
MAILERSEND_FROM_NAME=EventFinderTeam
# Яндекс: smtp.yandex.ru, порт 587. SMTP_PASSWORD — пароль приложения, не пароль входа в почту.
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=EventFinder
UPLOAD_DIR=wwwroot
# Пустой адрес: блок «Для вас» считается правилами.
# Модель: ml/recommender, POST /rank, ответ {"eventIds": ["..."]}.
RECOMMENDATION_MODEL_URL=
